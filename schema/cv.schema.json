{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glowfolio.github.io/schema/cv/1.0/cv.schema.json",
  "title": "Glowfolio CV (data publik)",
  "description": "Satu sumber data untuk tiga output: CV ATS, CV visual, dan web CV. File ini boleh berada di repo publik klien, jadi TIDAK BOLEH berisi nomor HP, email pribadi, alamat rumah, NIK, atau data sensitif lain. Data kontak ada di private.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "brand", "target", "profile", "experience", "education", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "$ref": "#/$defs/meta" },
    "brand": { "$ref": "#/$defs/brand" },
    "target": { "$ref": "#/$defs/target" },
    "profile": { "$ref": "#/$defs/profile" },
    "experience": {
      "type": "array",
      "description": "Urut dari yang terbaru.",
      "items": { "$ref": "#/$defs/experience" }
    },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "education": { "type": "array", "items": { "$ref": "#/$defs/education" } },
    "certifications": { "type": "array", "items": { "$ref": "#/$defs/certification" } },
    "skills": { "$ref": "#/$defs/skills" },
    "languages": { "type": "array", "items": { "$ref": "#/$defs/language" } },
    "organizations": {
      "type": "array",
      "description": "Organisasi, kepanitiaan, relawan.",
      "items": { "$ref": "#/$defs/experience" }
    },
    "awards": { "type": "array", "items": { "$ref": "#/$defs/award" } },
    "pitch": { "$ref": "#/$defs/pitch" },
    "outputs": { "$ref": "#/$defs/outputs" },
    "variants": {
      "type": "array",
      "description": "Varian CV per lowongan (add-on). Hanya menimpa bagian tertentu; sisanya mengikuti data utama.",
      "items": { "$ref": "#/$defs/variant" }
    }
  },

  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Slug unik, huruf kecil dan tanda hubung. Dipakai untuk referensi silang (urutan, varian)."
    },
    "yearMonth": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
      "description": "YYYY atau YYYY-MM."
    },
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "localizedText": {
      "description": "Teks satu bahasa, atau objek {id, en} untuk web dwibahasa.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          },
          "minProperties": 1
        }
      ]
    },
    "localizedList": {
      "type": "array",
      "items": { "$ref": "#/$defs/localizedText" }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {
          "enum": ["portfolio", "linkedin", "github", "gitlab", "behance", "dribbble", "medium", "youtube", "instagram", "website", "other"]
        },
        "label": { "type": "string" },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "$ref": "#/$defs/yearMonth" },
        "end": {
          "description": "Kosongkan atau isi \"present\" bila masih berjalan.",
          "oneOf": [{ "$ref": "#/$defs/yearMonth" }, { "const": "present" }]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "description": "%, jam, Rp juta, pengguna, dll." },
        "label": { "$ref": "#/$defs/localizedText" },
        "verified": {
          "type": "boolean",
          "default": false,
          "description": "True bila klien sudah mengonfirmasi angka ini benar. Angka yang belum terverifikasi tidak boleh tampil di output."
        }
      }
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "slug", "tier", "locales", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "slug": {
          "$ref": "#/$defs/id",
          "description": "Pengenal klien di sistem Glowfolio, bukan nama asli bila tidak perlu."
        },
        "tier": { "enum": ["rapi-ats", "signature", "web-card", "portfolio-pro", "brand-kit"] },
        "addons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["variant", "cover-letter", "translation", "extra-illustration", "linkedin", "express", "cv-care"] }
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["id", "en"] },
          "description": "Bahasa pertama = bahasa utama."
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },

    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "palette", "illustration"],
      "description": "Hasil Personal Brand Brief.",
      "properties": {
        "tone": {
          "enum": ["tegas-teknis", "tenang-analitis", "hangat-kolaboratif", "kreatif-berani", "formal-korporat"],
          "description": "Nada bicara: menentukan gaya kalimat ringkasan dan bullet."
        },
        "keywords": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string" },
          "description": "3–5 kata kesan yang ingin ditinggalkan."
        },
        "positioning": {
          "$ref": "#/$defs/localizedText",
          "description": "Satu baris posisi diri, mis. \"Engineer × Data × QA\"."
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "accent"],
          "properties": {
            "primary": { "$ref": "#/$defs/hexColor" },
            "accent": { "$ref": "#/$defs/hexColor" },
            "ink": { "$ref": "#/$defs/hexColor" },
            "ground": { "$ref": "#/$defs/hexColor" }
          }
        },
        "monogram": { "type": "string", "maxLength": 4 },
        "font": { "enum": ["geometric", "humanist", "serif", "mono"], "default": "geometric" },
        "illustration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol"],
          "properties": {
            "symbol": {
              "type": "string",
              "description": "Kunci figur di pustaka ilustrasi, mis. server-rack, data-chart, food-lab, design-desk, classroom, camera."
            },
            "extra": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Figur tambahan (Portfolio Pro, Brand Kit, add-on)."
            },
            "mode": { "enum": ["static", "interactive", "3d"], "default": "static" }
          }
        }
      }
    },

    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "careerStage"],
      "properties": {
        "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "industries": { "type": "array", "items": { "type": "string" } },
        "careerStage": { "enum": ["fresh-graduate", "early-career", "mid-level", "senior", "career-switch"] },
        "locations": { "type": "array", "items": { "type": "string" }, "description": "Kota atau \"remote\"." },
        "jobDescriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string" },
              "company": { "type": "string" },
              "url": { "$ref": "#/$defs/url" },
              "keywords": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },

    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "headline", "summary"],
      "properties": {
        "fullName": { "type": "string", "minLength": 2 },
        "preferredName": { "type": "string" },
        "headline": { "$ref": "#/$defs/localizedText" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "description": "Kota dan negara saja, tidak pernah alamat.",
          "properties": {
            "city": { "type": "string" },
            "country": { "type": "string" },
            "openToRemote": { "type": "boolean" }
          }
        },
        "photo": {
          "type": "string",
          "description": "Path relatif di repo, mis. assets/photo.jpg. Opsional; versi ATS tidak memakai foto."
        },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "contactForm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider"],
          "description": "Cara perekrut menghubungi lewat web tanpa membuka nomor/email.",
          "properties": {
            "provider": { "enum": ["formspree", "tally", "google-form", "none"] },
            "endpoint": { "$ref": "#/$defs/url" }
          }
        }
      }
    },

    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bullet"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "star": {
          "type": "object",
          "additionalProperties": false,
          "description": "Catatan story mining. Tidak dicetak langsung; bahan untuk bullet.",
          "properties": {
            "situation": { "type": "string" },
            "task": { "type": "string" },
            "action": { "type": "string" },
            "result": { "type": "string" }
          }
        },
        "bullet": { "$ref": "#/$defs/localizedText", "description": "Kalimat final yang tampil di CV." },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "highlight": { "type": "boolean", "default": false, "description": "Tampil di bagian sorotan web CV." }
      }
    },

    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organization", "role", "period"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "organization": { "type": "string" },
        "organizationUrl": { "$ref": "#/$defs/url" },
        "role": { "$ref": "#/$defs/localizedText" },
        "employmentType": { "enum": ["full-time", "contract", "part-time", "internship", "freelance", "volunteer"] },
        "location": { "type": "string" },
        "period": { "$ref": "#/$defs/period" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "confidential": {
          "type": "boolean",
          "default": false,
          "description": "True bila detail proyek kantor harus disamarkan di web publik."
        }
      }
    },

    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "role": { "$ref": "#/$defs/localizedText" },
        "period": { "$ref": "#/$defs/period" },
        "description": { "$ref": "#/$defs/localizedText" },
        "highlights": { "$ref": "#/$defs/localizedList" },
        "tech": { "type": "array", "items": { "type": "string" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "confidential": { "type": "boolean", "default": false },
        "caseStudy": {
          "type": "object",
          "additionalProperties": false,
          "description": "Halaman studi kasus (Portfolio Pro ke atas).",
          "properties": {
            "problem": { "$ref": "#/$defs/localizedText" },
            "approach": { "$ref": "#/$defs/localizedText" },
            "outcome": { "$ref": "#/$defs/localizedText" },
            "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
            "images": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["src", "alt"],
                "properties": {
                  "src": { "type": "string" },
                  "alt": { "type": "string", "minLength": 3 }
                }
              }
            }
          }
        }
      }
    },

    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "institution", "degree"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "institution": { "type": "string" },
        "degree": { "type": "string", "description": "S1, D3, SMK, dll." },
        "field": { "$ref": "#/$defs/localizedText" },
        "period": { "$ref": "#/$defs/period" },
        "gpa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "scale"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "scale": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "thesis": { "$ref": "#/$defs/localizedText" },
        "highlights": { "$ref": "#/$defs/localizedList" }
      }
    },

    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "issuer"],
      "properties": {
        "name": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "$ref": "#/$defs/yearMonth" },
        "expires": { "$ref": "#/$defs/yearMonth" },
        "credentialUrl": { "$ref": "#/$defs/url" }
      }
    },

    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups"],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "items"],
            "properties": {
              "name": { "$ref": "#/$defs/localizedText" },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "level": { "enum": ["familiar", "proficient", "advanced", "expert"] },
                    "years": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },

    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "level"],
      "properties": {
        "name": { "type": "string" },
        "level": { "enum": ["native", "C2", "C1", "B2", "B1", "A2", "A1"] },
        "certificate": { "type": "string", "description": "mis. TOEFL ITP 550, IELTS 6.5" }
      }
    },

    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedText" },
        "issuer": { "type": "string" },
        "date": { "$ref": "#/$defs/yearMonth" },
        "description": { "$ref": "#/$defs/localizedText" }
      }
    },

    "pitch": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kit interview selaras brand (Portfolio Pro ke atas).",
      "properties": {
        "elevator60s": { "$ref": "#/$defs/localizedText" },
        "tellMeAboutYourself": { "$ref": "#/$defs/localizedText" }
      }
    },

    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pages": { "enum": [1, 2], "default": 1 },
            "sectionOrder": {
              "type": "array",
              "items": { "enum": ["summary", "experience", "projects", "education", "skills", "certifications", "languages", "organizations", "awards"] }
            }
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pages": { "enum": [1, 2], "default": 1 },
            "layout": { "enum": ["sidebar-left", "sidebar-right", "single-column", "header-band", "timeline"], "default": "sidebar-left" },
            "showPhoto": { "type": "boolean", "default": false }
          }
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "mode": { "enum": ["single", "multi"], "default": "single" },
            "basePath": {
              "type": "string",
              "default": "/",
              "description": "\"/\" untuk username.github.io, \"/cv/\" bila dipasang sebagai project site."
            },
            "sections": {
              "type": "array",
              "items": { "enum": ["hero", "highlights", "experience", "projects", "case-studies", "skills", "education", "contact"] }
            },
            "qr": { "type": "boolean", "default": true },
            "analytics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider"],
              "properties": {
                "provider": { "enum": ["none", "goatcounter", "umami"] },
                "siteId": { "type": "string" }
              }
            },
            "customDomain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" }
          }
        }
      }
    },

    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "jobRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "jobRef": { "$ref": "#/$defs/id", "description": "id dari target.jobDescriptions." },
        "headline": { "$ref": "#/$defs/localizedText" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "achievementOrder": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "description": "id achievement yang ditampilkan, berurutan."
        },
        "extraKeywords": { "type": "array", "items": { "type": "string" } },
        "matchScore": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "before": { "type": "integer", "minimum": 0, "maximum": 100 },
            "after": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      }
    }
  }
}
